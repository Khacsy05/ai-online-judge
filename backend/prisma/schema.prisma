generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  STUDENT
  ADMIN
}

enum JudgeStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

model User {
  id          String            @id @default(uuid())
  email       String            @unique
  password    String
  fullName    String            // Họ và tên
  studentCode String?           @unique // Mã sinh viên
  role        Role              @default(STUDENT)

  classrooms  ClassroomMember[]
  submissions Submission[]
  createdProblems Problem[]     @relation("ProblemAuthor")
  
  createdAt   DateTime          @default(now())
}

model Classroom {
  id          String            @id @default(uuid())
  code        String            @unique // Mã lớp: 64CNTT_VA
  name        String            // Tên môn học
  members     ClassroomMember[]
  assignments Assignment[]      // Danh sách bài tập được giao cho lớp này
  createdAt   DateTime          @default(now())
}

model ClassroomMember {
  id          String    @id @default(uuid())
  userId      String
  classroomId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  joinedAt    DateTime  @default(now())

  @@unique([userId, classroomId])
}

// Kho bài tập dùng chung (Problem Bank)
model Problem {
  id            String       @id @default(uuid())
  title         String
  description   String       @db.Text
  timeLimitMs   Int          @default(1000)
  memoryLimitMb Int          @default(256)
  
  authorId      String
  author        User         @relation("ProblemAuthor", fields: [authorId], references: [id])
  testCases     TestCase[]
  assignments   Assignment[] // Bài này được giao ở những lớp nào
  createdAt     DateTime     @default(now())
}

// Bảng giao bài cho lớp với thời gian riêng biệt
model Assignment {
  id          String       @id @default(uuid())
  classroomId String
  problemId   String
  startTime   DateTime     // Giờ bắt đầu mở đề cho lớp này
  deadline    DateTime     // Hạn chót nộp bài của lớp này
  isPublished Boolean      @default(true)

  classroom   Classroom    @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submissions Submission[] // Các bài nộp thuộc ca/lớp này

  createdAt   DateTime     @default(now())

  @@unique([classroomId, problemId]) // Mỗi bài chỉ giao 1 lần trong 1 lớp
}

model TestCase {
  id             String             @id @default(uuid())
  problemId      String
  problem        Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String             @db.Text
  expectedOutput String             @db.Text
  isHidden       Boolean            @default(true)
  score          Float              @default(1.0)
  details        SubmissionDetail[]
}

model Submission {
  id              String             @id @default(uuid())
  userId          String
  assignmentId    String             // Nộp cho đợt giao bài nào của lớp
  sourceCode      String             @db.Text
  language        String
  status          JudgeStatus        @default(PENDING)
  totalScore      Float              @default(0)
  executionTimeMs Int?
  memoryUsedKb    Int?

  user            User               @relation(fields: [userId], references: [id])
  assignment      Assignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  details         SubmissionDetail[]
  createdAt       DateTime           @default(now())
}

model SubmissionDetail {
  id              String      @id @default(uuid())
  submissionId    String
  testCaseId      String
  status          JudgeStatus
  actualOutput    String?     @db.Text
  errorMessage    String?     @db.Text
  executionTimeMs Int?
  
  submission      Submission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase        TestCase    @relation(fields: [testCaseId], references: [id])
}